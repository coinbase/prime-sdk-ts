{
  "name": "@coinbase/prime-sdk-ts",
  "version": "0.11.0",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./manual": {
      "types": "./dist/types/client-manual.d.ts",
      "import": "./dist/client-manual.js",
      "require": "./dist/client-manual.js"
    },
    "./modular": {
      "types": "./dist/types/client-modular.d.ts",
      "import": "./dist/client-modular.js",
      "require": "./dist/client-modular.js"
    },
    "./services": {
      "types": "./dist/types/services.d.ts",
      "import": "./dist/services.js",
      "require": "./dist/services.js"
    },
    "./client": {
      "types": "./dist/types/client-only.d.ts",
      "import": "./dist/client-only.js",
      "require": "./dist/client-only.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "lint": "eslint . --ext .js,.ts,.mjs",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,css,md}\"",
    "check:lockfile": "node -e \"if(require('fs').readFileSync('package-lock.json','utf8').includes('cbhq.net')){console.error('package-lock.json must not reference cbhq.net');process.exit(1)}\"",
    "fetch-spec": "curl -o apiSpec/prime-public-api-spec.yaml https://api.prime.coinbase.com/v1/openapi.yaml",
    "gen-types": "openapi-generator generate -i apiSpec/prime-public-api-spec.yaml -g typescript-node --global-property models -o apiSpec/types --additional-properties=supportsES6=true --additional-properties=snapshot=true && cd apiSpec && node generateTypes.js",
    "replace-model": "rm -r src/model && cp -r apiSpec/types/processed src/model",
    "update-spec": "npm run fetch-spec && npm run gen-types && npm run replace-model"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:coinbase/prime-sdk-ts.git"
  },
  "keywords": [],
  "author": "sa@coinbase.com",
  "license": "ISC",
  "description": "Coinbase Prime API TypeScript SDK",
  "bugs": {
    "url": "https://github.com/coinbase/prime-sdk-ts/issues"
  },
  "homepage": "https://github.com/coinbase/prime-sdk-ts#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.35.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "js-yaml": "^4.2.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@coinbase/core-ts": "^0.4.0"
  }
}
